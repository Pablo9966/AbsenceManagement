{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "paths": {
      "@elipslife/frontend-platform": [
        "packages/frontend-platform/src/index.ts"
      ],
      "@elipslife/absence-service": [
        "services/absence-service/src/index.ts"
      ],
      "@elipslife/ktg-case-service": [
        "services/ktg-case-service/src/index.ts"
      ],
      "@elipslife/document-service": [
        "services/document-service/src/index.ts"
      ],
      "@elipslife/inbox-notification-service": [
        "services/inbox-notification-service/src/index.ts"
      ],
      "@elipslife/dashboard-projection-service": [
        "services/dashboard-projection-service/src/index.ts"
      ],
      "@elipslife/claims-intake-workspace-service": [
        "services/claims-intake-workspace-service/src/index.ts"
      ],
      "@elipslife/benefit-engine-service": [
        "services/benefit-engine-service/src/index.ts"
      ],
      "@elipslife/portal-workflow-client": [
        "packages/portal-workflow-client/src/index.ts"
      ],
      "@elipslife/identity-access-client": [
        "packages/identity-access-client/src/index.ts"
      ],
      "@elipslife/identity-access-service": [
        "services/identity-access-service/src/index.ts"
      ],
      "@elipslife/payment-operations-service": [
        "services/payment-operations-service/src/index.ts"
      ]
    },
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  }
}
