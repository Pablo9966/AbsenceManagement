{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "paths": {
      "@elipslife/frontend-platform": [
        "packages/frontend-platform/src/index.ts"
      ],
      "@elipslife/identity-access-service": [
        "services/identity-access-service/src/index.ts"
      ]
    },
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  }
}
