{
  "name": "elipslife-absence-management-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "tsc:build": "tsc -b",
    "lint": "echo \"lint configuration pending\"",
    "migrations:validate": "node ./tools/migrations.mjs validate",
    "migrations:plan": "node ./tools/migrations.mjs plan",
    "test:smoke": "npm run typecheck && node --experimental-transform-types --loader ./tests/ts-source-loader.mjs --test tests/phase-2b.smoke.test.mjs tests/phase-2c.smoke.test.mjs tests/phase-2d.smoke.test.mjs tests/phase-2e.smoke.test.mjs tests/phase-2f.smoke.test.mjs tests/phase-2g.smoke.test.mjs",
    "test:integration": "npm run typecheck && node --experimental-transform-types --loader ./tests/ts-source-loader.mjs --test tests/phase-2h.integration.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^6.0.3"
  }
}
